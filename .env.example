# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens

# Your Cloudflare Account ID (Dashboard → right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# R2 API Token credentials (server-side only — never expose in client code)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# The name you give your R2 bucket (e.g. "noor-quran-audio")
R2_BUCKET_NAME=noor-quran-audio

# Public base URL for the R2 bucket.
# Option A — R2 public bucket URL (enable "Public Access" in R2 bucket settings):
#   https://<bucket-name>.<account-id>.r2.cloudflarestorage.com
# Option B — Custom domain via Cloudflare (recommended for production):
#   https://audio.yourdomain.com
# NEXT_PUBLIC_ prefix is intentional: this is a read-only CDN URL, no secrets.
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-bucket-name.your-account-id.r2.cloudflarestorage.com
